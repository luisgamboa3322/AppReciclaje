# =====================================================================
# PECOX Vision — Variables de entorno para PRODUCCIÓN
# Copia este archivo como `.env` en el servidor y reemplaza cada valor marcado.
# NUNCA hagas commit de `.env` con secretos reales.
# =====================================================================

# --- Modo y dominio público ---
APP_ENV=production
API_DOMAIN=api.tu-dominio.com
WEB_DOMAIN=app.tu-dominio.com
API_HOST=0.0.0.0
API_PORT=8000

# Incluye exactamente tus orígenes HTTPS del panel web (y dominio móvil/preview si aplica)
CORS_ORIGINS=https://app.tu-dominio.com

# --- Base de datos PostgreSQL ---
POSTGRES_DB=pecox_vision
POSTGRES_USER=pecox_prod
# Genera una contraseña fuerte, por ejemplo: openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_POR_PASSWORD_SEGURO_DE_PRODUCCION

# --- Seguridad y JWT ---
# REQUISITO ESTRICTO en APP_ENV=production: >= 32 caracteres aleatorios sin prefijos de ejemplo.
# Ejemplo Linux/macOS: openssl rand -hex 32
JWT_SECRET_KEY=REEMPLAZA_POR_SECRETO_JWT_ALEATORIO_MINIMO_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Machine Learning / Inferencia CPU ---
ML_ARTIFACT_DIR=/repo/ml/artifacts
ML_MODEL_VERSION=resnet18-trashnet-v1.0.0
ML_CONFIDENCE_THRESHOLD=0.50
# Activa 2-view TTA (original + espejo horizontal) para mejorar estabilidad en cámara móvil
# a cambio de ~2x latencia CPU (~80 ms vs ~41 ms por foto en Intel i5).
ML_USE_TTA=true
MAX_IMAGE_UPLOAD_MB=10

# --- Dashboard Web Next.js (compilado en web build-args) ---
NEXT_PUBLIC_API_BASE_URL=https://api.tu-dominio.com/api/v1
