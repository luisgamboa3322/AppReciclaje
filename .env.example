# =====================================================================
# PECOX Vision — Ejemplo de variables de entorno (NO usar valores reales)
# Copia este archivo como `.env` localmente antes de iniciar los servicios
# =====================================================================

# --- Backend FastAPI (services/api) ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8443

# --- Base de datos PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pecox_vision
POSTGRES_USER=pecox_dev
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://pecox_dev:change_me_local_only@localhost:5432/pecox_vision

# --- Seguridad y JWT ---
# En APP_ENV=production debe tener >= 32 caracteres aleatorios sin prefijos de ejemplo
JWT_SECRET_KEY=replace_with_a_long_random_secret_for_local_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Machine Learning / Inferencia ---
ML_MODEL_VERSION=resnet18-trashnet-v1.0.0
ML_ARTIFACT_DIR=
ML_CONFIDENCE_THRESHOLD=0.50
MAX_IMAGE_UPLOAD_MB=10

# --- Dashboard Web Next.js (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
